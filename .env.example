# Copy to .env and fill in. Never commit .env.
DRIFTRAG_ENV=dev
DRIFTRAG_LOG_LEVEL=INFO
DRIFTRAG_DATA_DIR=data
DRIFTRAG_DATABASE_URL=postgresql://driftrag:change-me@127.0.0.1:5433/driftrag

# Used by deploy/compose.yaml for the local Postgres container
POSTGRES_PASSWORD=change-me

# LLM providers (free tiers). Only public data is ever sent to them.
# Gemini key: https://aistudio.google.com - Groq key (optional fallback): https://console.groq.com
GEMINI_API_KEY=
GROQ_API_KEY=
# DRIFTRAG_GENERATOR_MODEL=gemini/gemini-2.5-flash
# DRIFTRAG_FALLBACK_MODEL=groq/llama-3.3-70b-versatile
